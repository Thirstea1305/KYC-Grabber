# ============================================================
# KYC Grabber configuration (copy to .env and fill in)
# Every key is prefixed with KYC_ ; nested keys use "__".
# ============================================================

KYC_APP_ENV=dev
KYC_LOG_LEVEL=INFO

# ---------- storage ----------
KYC_DATA_DIR=data
KYC_STORE_PATH=data/kyc_grabber.sqlite3

# ---------- web dashboard ----------
KYC_WEB__HOST=127.0.0.1
KYC_WEB__PORT=8080

# ---------- mail intake ----------
# mode = filesystem (dev, watches data/inbox for *.eml) | imap (production)
KYC_MAIL__MODE=filesystem
KYC_MAIL__INBOX_DIR=data/inbox
KYC_MAIL__PROCESSED_DIR=data/inbox/processed
KYC_MAIL__POLL_INTERVAL_SECONDS=5
KYC_MAIL__INCLUDE_ALREADY_SEEN=false

# ---------- intake filter (which emails we react to) ----------
# comma separated; supports "*", exact address, "@domain.com" or "re:<regex>"
KYC_FILTER__ALLOWED_SENDERS=*
# required subject token, matched case-insensitively. Use "" to accept any subject.
KYC_FILTER__SUBJECT_TOKEN=[KYC]
KYC_FILTER__ALLOWED_ATTACHMENT_EXTENSIONS=.csv
KYC_FILTER__MAX_ATTACHMENT_BYTES=5242880
KYC_FILTER__MAX_CODES_PER_REQUEST=500
KYC_FILTER__REPLY_ON_REJECT=true

# ---------- IMAP (only used when KYC_MAIL__MODE=imap) ----------
KYC_MAIL__IMAP__HOST=imap.example.com
KYC_MAIL__IMAP__PORT=993
KYC_MAIL__IMAP__USE_SSL=true
KYC_MAIL__IMAP__USERNAME=kyc-bot@example.com
KYC_MAIL__IMAP__PASSWORD=change-me
KYC_MAIL__IMAP__MAILBOX=INBOX
KYC_MAIL__IMAP__PROCESSED_MAILBOX=Processed
KYC_MAIL__IMAP__MARK_SEEN=true
KYC_MAIL__IMAP__IDLE_TIMEOUT_SECONDS=240
KYC_MAIL__IMAP__RECONNECT_BACKOFF_SECONDS=15

# ---------- outbound replies ----------
# mode = filesystem (write .eml to data/outbox) | smtp
KYC_OUTBOUND__MODE=filesystem
KYC_OUTBOUND__OUTBOX_DIR=data/outbox
KYC_OUTBOUND__FROM_ADDRESS=kyc-bot@example.com
KYC_OUTBOUND__SUBJECT_TEMPLATE=KYC report for {filename} ({count} third parties)
KYC_OUTBOUND__SMTP__HOST=smtp.example.com
KYC_OUTBOUND__SMTP__PORT=587
KYC_OUTBOUND__SMTP__USE_STARTTLS=true
KYC_OUTBOUND__SMTP__USERNAME=kyc-bot@example.com
KYC_OUTBOUND__SMTP__PASSWORD=change-me

# ---------- simulated external registry ----------
KYC_EXTERNAL__LATENCY_MS=180
KYC_EXTERNAL__JITTER_MS=120
KYC_EXTERNAL__FAILURE_RATE=0.03
KYC_EXTERNAL__NOT_FOUND_RATE=0.12
KYC_EXTERNAL__MAX_RETRIES=3
KYC_EXTERNAL__RETRY_BACKOFF_SECONDS=0.4
KYC_EXTERNAL__CONCURRENCY=8

# ---------- simulated internal DB ----------
KYC_INTERNAL__LATENCY_MS=25
KYC_INTERNAL__SEED_PATH=data/internal_db_seed.json

# ---------- pipeline ----------
KYC_PIPELINE__WORKERS=2
KYC_PIPELINE__CODE_CONCURRENCY=6
KYC_PIPELINE__CODE_TIMEOUT_SECONDS=30

# ---------- excel output ----------
KYC_EXCEL__OUTPUT_DIR=data/out
KYC_EXCEL__INCLUDE_SUMMARY_SHEET=true
KYC_EXCEL__INCLUDE_RAW_PAYLOAD=true
